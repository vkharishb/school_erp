# =============================================================================
# School ERP – .gitignore
# =============================================================================

# ----- Secrets / env (NEVER commit) -----
.env
.env.*
!.env.example
backend/.env
frontend/.env
*.pem
*.key
secrets/
certs/
backups/

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
dist/
build/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
*.egg

# ----- Node / Frontend -----
node_modules/
frontend/dist/
frontend/build/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local
*.tsbuildinfo

# ----- IDE / editors -----
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# ----- OS -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- App data / uploads -----
backend/uploads/
uploads/
media/
*.db
*.sqlite3
*.sqlite

# ----- Docker / local volumes -----
postgres_data/
redis_data/

# ----- Logs / coverage -----
*.log
logs/
coverage/
.nyc_output/

# ----- Misc -----
*.bak
*.tmp
*.temp
*.cache/
*.md
