APP_NAME=SchoolERP
APP_ENV=development
DEBUG=false
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300

DATABASE_URL=postgresql+asyncpg://schoolerp:CHANGE_ME@127.0.0.1:5432/schoolerp_dev
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SUPER_ADMIN_EMAIL=superadmin@schoolerp.local
SUPER_ADMIN_USERNAME=CHANGE_ME_PLATFORM_USERNAME
SUPER_ADMIN_PASSWORD=CHANGE_ME_BEFORE_BOOTSTRAP_123!
SUPER_ADMIN_FULL_NAME=Platform Super Admin

LICENSE_VALIDATION_INTERVAL_HOURS=24

REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_NAME=schoolerp_refresh
BACKUP_DIR=/app/backups
BACKUP_SCHEDULE_HOURS=24
BACKUP_RETENTION_COUNT=30
BACKUP_OFFSITE_DIR=
BACKUP_DAILY_RETENTION_DAYS=30
BACKUP_WEEKLY_RETENTION_WEEKS=12
BACKUP_MONTHLY_RETENTION_MONTHS=12
REQUIRE_RECENT_BACKUP_FOR_ARCHIVE=false
ARCHIVE_BACKUP_MAX_AGE_HOURS=24
BROWSER_RESTORE_ENABLED=false
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
