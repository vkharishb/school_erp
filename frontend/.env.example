# Local Vite development only. Copy to .env.local; never commit .env.local.
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_TARGET=http://127.0.0.1:8001

# Optional client branding. Tenant configuration replaces this after sign-in.
# These are public frontend values; do not place secrets in VITE_* variables.
VITE_SCHOOL_NAME=YOUR SCHOOL NAME
VITE_PRODUCT_NAME=School ERP
VITE_LOGIN_TAGLINE=Smart learning. Simple administration. Secure operations.
VITE_LOGIN_WELCOME=One secure workspace for students, teachers, fees, attendance and academics.
VITE_RELEASE_VERSION=V1.1.DEV.15
